# ============================================================
# 履约后台 · 环境变量示例
#
# 用法:复制为 .env(与 docker-compose.yml 同目录)。.env 不进 git(见 .gitignore)。
#
# 三样「应用之外」的资源由本文件指向,应用不感知背后是容器还是托管:
#   · 库           → DATABASE_URL
#   · 对象存储     → STORAGE_BACKEND + S3_*
#   · 反向代理/TLS → 不在这里,由宿主 1Panel(OpenResty)承载
#
# 两个环境【只有本文件不同】,docker-compose.yml 完全一致:
#   初期(阿里云 ECS):库/对象存储用容器 → 用【初期】标注的值,`docker compose up -d --build`
#   生产(OVH)      :库=托管PG、存储=OVH → 用【生产】标注的值,`docker compose -f docker-compose.yml up -d --build`
#
# 本地开发(不走容器,复用 brew PG @5433)另见 README「本地开发」。
# ============================================================

# ============================================================
# 【库】DATABASE_URL —— 初期 / 生产 二选一
# ============================================================
# 初期:指向 override 起的 db 容器(host=db)。POSTGRES_* 同时供 db 容器初始化,口令须与 URL 一致。
DATABASE_URL=postgresql+asyncpg://fulfillment:change-me-strong-db@db:5432/fulfillment
POSTGRES_DB=fulfillment
POSTGRES_USER=fulfillment
POSTGRES_PASSWORD=change-me-strong-db

# 生产(OVH 托管 PG):删掉上面初期那三行,改用下面这行(host/账号/库名以 OVH 面板为准):
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<ovh-managed-pg-host>:5432/<db>
#   —— 生产不需要 POSTGRES_*(不起 db 容器)。

# ============================================================
# 【对象存储】STORAGE_BACKEND + S3_* —— 初期 / 生产 二选一
# ============================================================
STORAGE_BACKEND=s3

# 初期:指向 override 起的 minio 容器(compose 内网,不对公网)。S3 账号=MinIO root,两处须一致。
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minio
S3_SECRET_KEY=change-me-strong-minio
S3_BUCKET=fulfillment-attachments
S3_PUBLIC_BASE_URL=
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me-strong-minio

# 生产(OVH Object Storage):改成 OVH 的 S3 兼容 endpoint / 密钥 / bucket(桶在 OVH 面板预建):
# S3_ENDPOINT_URL=https://s3.<region>.io.cloud.ovh.net
# S3_REGION=<ovh-region>
# S3_ACCESS_KEY=<ovh-access-key>
# S3_SECRET_KEY=<ovh-secret-key>
# S3_BUCKET=fulfillment-attachments
#   —— 生产不需要 MINIO_ROOT_*(不起 minio 容器)。

# ============================================================
# 【对外访问地址】—— 初期填 IP,生产填域名
# ============================================================
# 浏览器访问后端的公网地址(前端构建时内联 + SSR 运行时读)。
# 初期(1Panel 反代 http,走 IP):
API_BASE_URL=http://<你的ECS公网IP>
# 生产(1Panel 反代 https,走域名):
# API_BASE_URL=https://erp.matgohq.com

# 允许的前端 origin(1Panel 单域名反代时与页面同源即可;逗号分隔多个)。
CORS_ORIGINS=http://<你的ECS公网IP>
# 生产:CORS_ORIGINS=https://erp.matgohq.com
CORS_ALLOW_CREDENTIALS=true

# ============================================================
# 【安全】JWT / 管理员 / cookie —— 部署前必改
# ============================================================
JWT_SECRET_KEY=change-me-to-random-min-16-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

SUPER_ADMIN_EMAIL=superadmin@fulfillment.local
# 必填无默认;6-20 位字母数字,部署前改强口令
SUPER_ADMIN_INITIAL_PASSWORD=ChangeMe12345

# HTTP 阶段(初期,走 IP)留 false;接 HTTPS(生产,走域名)后两者一起改 true:
REFRESH_COOKIE_SECURE=false
ENABLE_HSTS=false
# 生产:REFRESH_COOKIE_SECURE=true  /  ENABLE_HSTS=true
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_PATH=/api/v1/auth
REFRESH_COOKIE_MAX_AGE=604800
REFRESH_COOKIE_SAMESITE=lax

# 前置 1Panel/OpenResty 反代 + 应用端口只绑 127.0.0.1 → 可信,true(读 X-Forwarded-For 做限流/日志)
TRUST_PROXY=true
TRUST_INBOUND_TRACE_ID=false

# 生产保持 false,不对公网暴露接口面(/docs /redoc /openapi.json)
ENABLE_API_DOCS=false

# ============================================================
# 【限流 / 账号锁定 / 日志】—— 一般用默认
# ============================================================
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_MAX_FAILURES=5
LOGIN_RATE_LIMIT_LOCK_SECONDS=300
ACCOUNT_LOCK_THRESHOLD=10
ACCOUNT_LOCK_MINUTES=15
LOG_LEVEL=INFO

# ============================================================
# 【宿主端口】—— 只绑 127.0.0.1,由 1Panel 反代对外(一般不用改)
# ============================================================
# 1Panel 反代规则:/api → 127.0.0.1:8001,其余 → 127.0.0.1:3001
BACKEND_HOST_PORT=8001
FRONTEND_HOST_PORT=3001
# MinIO 控制台(仅初期,仅 127.0.0.1 备排障):
MINIO_CONSOLE_PORT=9001

# ---- 单据附件上限(均有默认,一般无需改) ----
# ATTACHMENT_MAX_SIZE_BYTES=52428800           # 单文件上限(默认 50MB)
# ATTACHMENT_ORPHAN_TTL_HOURS=72               # 未提交表单的孤儿附件可关联/下载时效
# ATTACHMENT_ORPHAN_QUOTA_COUNT=20             # 单用户活动孤儿数量上限
# ATTACHMENT_ORPHAN_QUOTA_BYTES=104857600      # 单用户活动孤儿字节上限(默认 100MB)
# ATTACHMENT_MAX_PER_OWNER=10                  # 单报关记录关联附件数上限
