# ============================================================
# 履约后台 · 环境变量示例
#
# 用途:
#   · 本地整机 build 测试 → 复制为 .env(docker-compose.yml 用)
#   · 服务器部署         → 复制为 .env.production(docker-compose.production.yml + deploy/deploy.sh 用)
#   .env / .env.production 均不进 git(见 .gitignore)。
#
# 三样「应用之外」的资源:
#   · 库           → POSTGRES_*(容器 db;DATABASE_URL 由 compose 拼)。OVH 上线前切托管见 README。
#   · 对象存储     → STORAGE_BACKEND + S3_*(容器 minio)。OVH 上线前切 Object Storage。
#   · 反向代理/TLS → 不在这里,宿主 1Panel(OpenResty)承载。
#
# 本地开发(不走容器,brew PG @5433 + uvicorn/pnpm)见 README「本地开发」,不用本文件。
# ============================================================

# ---- 镜像(仅生产部署 docker-compose.production.yml 用;本地 build 忽略)----
# CI 部署时由流水线注入,手动部署才需在 .env.production 填。
# IMAGE_REGISTRY=crpi-xxxx.cn-hangzhou.personal.cr.aliyuncs.com/<命名空间>   # ECS 用 ACR
# IMAGE_REGISTRY=ghcr.io/matgo-dev/buildreach-fulfillment                    # OVH 用 GHCR
# IMAGE_TAG=main-abc1234

# ---- 库(容器 db;DATABASE_URL 由 compose 从 POSTGRES_* 拼)----
POSTGRES_DB=fulfillment
POSTGRES_USER=fulfillment
POSTGRES_PASSWORD=change-me-strong-db

# ---- 对象存储(容器 minio,s3 兼容)----
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=fulfillment-attachments
S3_PUBLIC_BASE_URL=
# S3 账号=MinIO root(留空则 compose 回落到下面 MINIO_ROOT_*,两者须一致)
S3_ACCESS_KEY=minio
S3_SECRET_KEY=change-me-strong-minio
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me-strong-minio

# ---- 对外访问地址 ----
# 浏览器访问后端的公网地址(前端 entrypoint 运行时注入 __env.js)。
# ECS(1Panel 反代 http,走 IP):
API_BASE_URL=http://<你的ECS公网IP>
# OVH(1Panel 反代 https,走域名):API_BASE_URL=https://erp.matgohq.com
CORS_ORIGINS=http://<你的ECS公网IP>
CORS_ALLOW_CREDENTIALS=true

# ---- 安全(部署前必改)----
JWT_SECRET_KEY=change-me-to-random-min-16-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
SUPER_ADMIN_EMAIL=superadmin@fulfillment.local
SUPER_ADMIN_INITIAL_PASSWORD=ChangeMe12345
# HTTP 阶段(ECS,走 IP)留 false;接 HTTPS(OVH,走域名)后两者一起 true:
REFRESH_COOKIE_SECURE=false
ENABLE_HSTS=false
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_PATH=/api/v1/auth
REFRESH_COOKIE_MAX_AGE=604800
REFRESH_COOKIE_SAMESITE=lax
# 前置 1Panel 反代 + 端口只绑 127.0.0.1 → true(读 X-Forwarded-For)
TRUST_PROXY=true
TRUST_INBOUND_TRACE_ID=false
# 生产保持 false,不对公网暴露接口面
ENABLE_API_DOCS=false

# ---- 限流 / 账号锁定 / 日志(一般用默认)----
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_MAX_FAILURES=5
LOGIN_RATE_LIMIT_LOCK_SECONDS=300
ACCOUNT_LOCK_THRESHOLD=10
ACCOUNT_LOCK_MINUTES=15
LOG_LEVEL=INFO

# ---- 宿主端口(只绑 127.0.0.1,由 1Panel 反代对外)----
# 1Panel 反代规则:/api → 127.0.0.1:17858,其余 → 127.0.0.1:7858
# 端口沿用前台 7857/17857 的并行约定(履约 = 7858/17858)
BACKEND_HOST_PORT=17858
FRONTEND_HOST_PORT=7858
MINIO_CONSOLE_PORT=9001

# ---- 镜像仓库登录(仅 deploy.sh 手动拉镜像用;CI 部署由流水线注入,一般不填)----
# ACR_USERNAME=
# ACR_PASSWORD=
# GHCR_TOKEN=

# ---- 单据附件上限(均有默认,一般无需改)----
# ATTACHMENT_MAX_SIZE_BYTES=52428800
# ATTACHMENT_ORPHAN_TTL_HOURS=72
# ATTACHMENT_ORPHAN_QUOTA_COUNT=20
# ATTACHMENT_ORPHAN_QUOTA_BYTES=104857600
# ATTACHMENT_MAX_PER_OWNER=10
