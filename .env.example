# ============================================================
# 履约系统 · 环境变量示例
#
# 本地开发:复制为 backend/.env,DATABASE_URL 指向已有的 brew PG(fulfillment_dev)。
# 容器部署:复制为 .env(docker-compose 用),此时 DATABASE_URL 由 compose 拼出,
#           这里的 POSTGRES_* 供 compose 的 db 服务使用。
#
# 只含 M0 config surface(backend/app/core/config.py 实际读取的字段),
# 无 SMTP / 翻译 / LLM / WhatsApp 等 —— 本仓库不含这些功能。
# ============================================================

# ---- 数据库 ----
# 本地开发(复用现有 brew PG @5433,独立 database,不走 compose db 服务):
DATABASE_URL=postgresql+asyncpg://<your-pg-user>@localhost:5433/fulfillment_dev

# 容器部署(docker-compose 用,拼进 backend 的 DATABASE_URL,见 docker-compose.yml):
POSTGRES_DB=fulfillment
POSTGRES_USER=fulfillment
POSTGRES_PASSWORD=change-me-in-deploy

# ---- JWT ----
JWT_SECRET_KEY=dev-secret-key-change-me-min-16-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- 引导管理员(启动时幂等 seed) ----
SUPER_ADMIN_EMAIL=superadmin@fulfillment.local
# 必填,无默认值(漏配起不来);6-20 位字母数字,部署前务必改成强口令
SUPER_ADMIN_INITIAL_PASSWORD=ChangeMe12345

LOG_LEVEL=INFO

# ---- CORS(逗号分隔) ----
CORS_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# ---- 登录限流(单机内存,不支持多进程/多实例;第一道减速带) ----
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_MAX_FAILURES=5
LOGIN_RATE_LIMIT_LOCK_SECONDS=300

# ---- 账号级登录锁定(落用户行,换 IP/重启不绕过;第二道) ----
# 连续失败达阈值锁定 N 分钟;登录成功或管理员重置密码即解锁
ACCOUNT_LOCK_THRESHOLD=10
ACCOUNT_LOCK_MINUTES=15

# ---- Refresh token cookie ----
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_PATH=/api/v1/auth
REFRESH_COOKIE_MAX_AGE=604800
# 纯 HTTP 部署留 false;接 HTTPS 后改 true
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
# refresh 重放宽限窗(秒):同族 cookie 被多标签页并发轮换的竞态容忍窗;窗外复用判重放撤整族
REFRESH_REPLAY_GRACE_SECONDS=60

# ---- Trace / Proxy(前置可信网关时才置 true) ----
TRUST_INBOUND_TRACE_ID=false
TRUST_PROXY=false

# ---- API 文档(/docs /redoc /openapi.json)开关 ----
# 本地开发可置 true;生产保持 false(默认),不对公网暴露接口面
ENABLE_API_DOCS=false

# ---- HSTS 响应头开关 ----
# 纯 HTTP 部署留 false(浏览器忽略 HSTS);接 HTTPS 后改 true(与 REFRESH_COOKIE_SECURE 同思路)
ENABLE_HSTS=false

# ---- 对象存储(附件)—— local | s3 ----
# local:本地开发默认,写入 backend/private_uploads/attachments,以下 S3_* 留空即可。
# s3:MinIO(本地/compose)或生产 S3 兼容云对象存储,需填齐下面各项。
STORAGE_BACKEND=local

# STORAGE_BACKEND=s3 时才需要,否则留空/不设置:
# S3_ENDPOINT_URL=http://localhost:9000       # 本地 MinIO;生产填对象存储服务的 S3 兼容 endpoint
# S3_REGION=cn-hangzhou
# S3_ACCESS_KEY=minio
# S3_SECRET_KEY=minio123
# S3_BUCKET=fulfillment-attachments
# S3_PUBLIC_BASE_URL=                          # 公开资产基址,附件为私有下载,通常留空

# ---- 单据附件(报关单/放行扫描件等,中转上传;均有默认值,一般无需改) ----
# ATTACHMENT_MAX_SIZE_BYTES=52428800           # 单文件上限(默认 50MB)
# ATTACHMENT_ORPHAN_TTL_HOURS=72               # 未提交表单的孤儿附件可关联/下载时效
# ATTACHMENT_ORPHAN_QUOTA_COUNT=20             # 单用户活动孤儿数量上限
# ATTACHMENT_ORPHAN_QUOTA_BYTES=104857600      # 单用户活动孤儿字节上限(默认 100MB)
# ATTACHMENT_MAX_PER_OWNER=10                  # 单报关记录关联附件数上限

# ---- MinIO 服务自身(仅 docker-compose 的 minio 服务读取,供演示/部署用) ----
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123

# ---- 前端(仅容器部署用,frontend 服务读取;本地开发用 `pnpm dev` 默认 http://localhost:8000) ----
API_BASE_URL=http://localhost:8000
